{
  "name": "dsh-ag-swarm",
  "version": "0.1.9",
  "description": "Antigravity-style multi-agent swarm plugin for DeepSeek Harness (DSH): persistent parallel agents, shared channel blackboard, @mention doorbell wakeups, worktree isolation, stall monitor, and full 5-tab Hive/Board/Members/Graph/Raw Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libo0118/dsh-ag-swarm.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "swarm",
    "multi-agent",
    "antigravity",
    "hive",
    "blackboard"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "minVersion": "0.2.2-rc.3",
    "testedVersions": [
      "0.2.2-rc.3"
    ],
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "doctor": "node scripts/doctor.mjs",
    "pack:tgz": "pnpm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/doctor.mjs",
    "tools/install-local.mjs",
    "README.md"
  ]
}
